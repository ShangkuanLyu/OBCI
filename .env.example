# Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute origin of this deployment, including any base path (used for canonical/hreflang/OG URLs and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret key (service role). Needed for the Stripe webhook handler.
SUPABASE_SECRET_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Build flags (leave unset for local dev and Node/Vercel hosting) ---
# STATIC_EXPORT=1 — fully static build for GitHub Pages (output: export, trailing slashes, basePath applied).
STATIC_EXPORT=
# Sub-path the static export is served under (e.g. /OBCI); only honoured when STATIC_EXPORT=1.
NEXT_PUBLIC_BASE_PATH=
